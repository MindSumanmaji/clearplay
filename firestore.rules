rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User-specific private collections (History, Watch Later, Subs)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Cross-device discovery over same Wi-Fi (No login required)
    match /networks/{networkHash}/devices/{deviceId} {
      allow read, write: if true;
    }

    // Shared session rooms for TV casting and remote playback control
    match /connect_rooms/{roomId} {
      allow read, write: if true;
    }

    // 6-digit TV Pairing Codes (YouTube-style Link with TV Code)
    match /pairing_codes/{code} {
      allow read, write: if true;
    }
  }
}

